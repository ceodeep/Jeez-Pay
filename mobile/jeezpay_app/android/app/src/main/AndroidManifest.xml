<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />


    <application

        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@drawable/ic_jeezpay_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_jeezpay_logo"
        android:supportsRtl="false"
        android:theme="@style/JeezPayTheme">
        <activity android:name=".KycActivity"  android:exported="false"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>




        <!-- AUTH is the ONLY launcher -->
        <activity
            android:name=".AuthActivity"
            android:exported="true"
            android:theme="@style/JeezPaySplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>



        <!-- MAIN must NOT be launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false" />
        <activity android:name=".ProfileDetailsActivity" android:exported="false"/>
        <activity android:name=".SecurityActivity" android:exported="false"/>
        <activity android:name=".PaymentSettingsActivity" android:exported="false"/>
        <activity android:name=".AboutActivity" android:exported="false"/>

        <activity
            android:name=".send.SendMoneyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.receipt.ReceiptActivity"
            android:exported="false" />

        <activity android:name=".PinVerifyActivity" />

        <activity android:name=".ReferralActivity" />

        <activity android:name=".SettingsActivity" android:exported="false" />

        <activity android:name=".ChangePinActivity" android:exported="false" />
        <activity android:name=".LimitsActivity" android:exported="false" />
        <activity android:name=".PrivacyActivity" android:exported="false" />
        <activity android:name=".TermsActivity" android:exported="false" />
        <activity android:name=".ActiveSessionsActivity" />
        <activity android:name=".ChangePasswordActivity" />
        <activity android:name=".ReceiveQrActivity" />
        <activity android:name=".SwapActivity" />
        <activity android:name=".SwapReceiptActivity" />
        <activity android:name=".TransactionsActivity" />
        <activity android:name=".DepositUsdtActivity" />
        <activity android:name=".CryptoDepositsActivity" />
        <activity android:name=".ServicesActivity" />
        <activity android:name=".ServiceRequestActivity" />
        <activity android:name=".ServiceRequestsActivity" />
        <activity android:name=".CrashReportActivity" />
        <activity android:name=".ResetPasswordActivity" android:exported="false" />
        <activity android:name=".ChangeEmailActivity" android:exported="false" />
        <activity android:name=".DepositActivity" android:exported="false" />

        <activity
            android:name=".PortraitCaptureActivity"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme" />


    </application>

</manifest>
