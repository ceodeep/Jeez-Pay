<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@android:color/white">

    <TextView android:id="@+id/tvAvatarDialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose Avatar" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />

    <TextView android:id="@+id/tvAvatarDialogSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="20dp" android:text="Choose a profile style" android:textColor="@color/text_secondary" android:textSize="14sp" />

    <GridLayout android:id="@+id/avatarGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:alignmentMode="alignBounds" android:columnCount="3" android:useDefaultMargins="false">

        <FrameLayout android:id="@+id/avatarItem1" android:layout_width="96dp" android:layout_height="96dp" android:layout_margin="8dp" android:background="@drawable/bg_avatar_item" android:padding="10dp">

            <ImageView android:id="@+id/avatarOption1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/avatar_default" />

            <ImageView android:id="@+id/avatarCheck1" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:padding="0dp" android:src="@drawable/ic_avatar_selected" android:visibility="gone" />
        </FrameLayout>

        <FrameLayout android:id="@+id/avatarItem2" android:layout_width="96dp" android:layout_height="96dp" android:layout_margin="8dp" android:background="@drawable/bg_avatar_item" android:padding="10dp">

            <ImageView android:id="@+id/avatarOption2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/avatar_modern_2" />

            <ImageView android:id="@+id/avatarCheck2" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:padding="0dp" android:src="@drawable/ic_avatar_selected" android:visibility="gone" />
        </FrameLayout>

        <FrameLayout android:id="@+id/avatarItem3" android:layout_width="96dp" android:layout_height="96dp" android:layout_margin="8dp" android:background="@drawable/bg_avatar_item" android:padding="10dp">

            <ImageView android:id="@+id/avatarOption3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/avatar_modern_3" />

            <ImageView android:id="@+id/avatarCheck3" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:padding="0dp" android:src="@drawable/ic_avatar_selected" android:visibility="gone" />
        </FrameLayout>

        <FrameLayout android:id="@+id/avatarItem4" android:layout_width="96dp" android:layout_height="96dp" android:layout_margin="8dp" android:background="@drawable/bg_avatar_item" android:padding="10dp">

            <ImageView android:id="@+id/avatarOption4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/avatar_modern_4" />

            <ImageView android:id="@+id/avatarCheck4" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:padding="0dp" android:src="@drawable/ic_avatar_selected" android:visibility="gone" />
        </FrameLayout>

        <FrameLayout android:id="@+id/avatarItem5" android:layout_width="96dp" android:layout_height="96dp" android:layout_margin="8dp" android:background="@drawable/bg_avatar_item" android:padding="10dp">

            <ImageView android:id="@+id/avatarOption5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/avatar_modern_5" />

            <ImageView android:id="@+id/avatarCheck5" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:padding="0dp" android:src="@drawable/ic_avatar_selected" android:visibility="gone" />
        </FrameLayout>

        <FrameLayout android:id="@+id/avatarItem6" android:layout_width="96dp" android:layout_height="96dp" android:layout_margin="8dp" android:background="@drawable/bg_avatar_item" android:padding="10dp">

            <ImageView android:id="@+id/avatarOption6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/avatar_modern_6" />

            <ImageView android:id="@+id/avatarCheck6" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|end" android:padding="0dp" android:src="@drawable/ic_avatar_selected" android:visibility="gone" />
        </FrameLayout>

    </GridLayout>
</LinearLayout>