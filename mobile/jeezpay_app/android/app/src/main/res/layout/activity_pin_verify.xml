<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main">

    <ImageView android:id="@+id/ivBack" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="16dp" android:layout_marginTop="18dp" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Back" android:focusable="true" android:padding="10dp" android:src="@drawable/ic_back" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:tint="@color/text_primary" />

    <TextView android:id="@+id/tvHeader" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transaction verification" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@id/ivBack" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/ivBack" />

    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" android:scrollbars="none" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/ivBack">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="20dp" android:paddingEnd="24dp" android:paddingBottom="28dp">

            <!-- Clickable biometric action -->
            <com.google.android.material.card.MaterialCardView android:layout_width="82dp" android:layout_height="82dp" app:cardBackgroundColor="@color/bg_soft_blue" app:cardCornerRadius="26dp" app:cardElevation="0dp">

                <ImageView android:id="@+id/ivFinger" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Pay with fingerprint" android:focusable="true" android:padding="22dp" android:src="@drawable/ic_fingerprint" />

            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="Confirm transaction" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />

            <TextView android:id="@+id/tvSubTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center" android:lineSpacingExtra="2dp" android:text="Enter your 4-digit transaction PIN or use fingerprint." android:textColor="@color/text_secondary" android:textSize="14sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Enter your 4-digit transaction PIN to continue." android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="normal" android:id="@+id/tvBiometricHint" android:gravity="center" />

            <!-- PIN dots -->
            <LinearLayout android:id="@+id/pinDots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">

                <ImageView android:id="@+id/dot1" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_pin_dot_empty" />

                <ImageView android:id="@+id/dot2" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_pin_dot_empty" />

                <ImageView android:id="@+id/dot3" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_pin_dot_empty" />

                <ImageView android:id="@+id/dot4" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_pin_dot_empty" />

            </LinearLayout>

            <!-- Keypad -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" app:cardBackgroundColor="@color/card_white" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="@color/card_stroke_soft" app:strokeWidth="1dp">

                <androidx.gridlayout.widget.GridLayout android:id="@+id/keypad" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="14dp" android:paddingBottom="12dp" app:columnCount="3" app:rowCount="4">

                    <TextView android:id="@+id/key1" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="1" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key2" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="2" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key3" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="3" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key4" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="4" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key5" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="5" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key6" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="6" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key7" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="7" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key8" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="8" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key9" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="9" app:layout_columnWeight="1" />

                    <!-- No fake bullet key -->
                    <Space android:layout_width="0dp" android:layout_height="64dp" app:layout_columnWeight="1" />

                    <TextView android:id="@+id/key0" style="@style/PinKeyStyle" android:layout_width="0dp" android:layout_height="64dp" android:clickable="true" android:focusable="true" android:gravity="center" android:text="0" app:layout_columnWeight="1" />

                    <ImageView android:id="@+id/btnBackspace" android:layout_width="0dp" android:layout_height="64dp" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:contentDescription="Delete digit" android:focusable="true" android:padding="19dp" android:src="@drawable/ic_backspace" app:layout_columnWeight="1" app:tint="@color/text_primary" />

                </androidx.gridlayout.widget.GridLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Existing ID retained for compatibility, but no redundant button -->
            <TextView android:id="@+id/btnConfirm" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />

            <!-- Existing ID retained -->
            <EditText android:id="@+id/etHiddenPin" android:layout_width="1dp" android:layout_height="1dp" android:alpha="0" android:background="@android:color/transparent" android:cursorVisible="false" android:focusable="false" android:importantForAutofill="no" android:inputType="numberPassword" android:maxLength="4" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>