<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_media_previous"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Settings"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Account -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="Account" />

        <LinearLayout
            style="@style/SettingsCard">

            <include
                android:id="@+id/rowProfile"
                layout="@layout/item_settings_row_profile" />

            <include
                android:id="@+id/rowKyc"
                layout="@layout/item_settings_row_kyc" />
        </LinearLayout>

        <!-- Security -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="Security" />

        <LinearLayout
            style="@style/SettingsCard">

            <include
                android:id="@+id/rowSecurity"
                layout="@layout/item_settings_row_security" />

            <include
                android:id="@+id/rowChangePin"
                layout="@layout/item_settings_row_pin" />
        </LinearLayout>

        <!-- Payments -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="Payments" />

        <LinearLayout
            style="@style/SettingsCard">

            <include
                android:id="@+id/rowPaymentSettings"
                layout="@layout/item_settings_row_payments" />

            <include
                android:id="@+id/rowLimits"
                layout="@layout/item_settings_row_limits" />
        </LinearLayout>

        <!-- Rewards -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="Rewards" />

        <LinearLayout
            style="@style/SettingsCard">

            <include
                android:id="@+id/rowReferral"
                layout="@layout/item_settings_row_referral" />
        </LinearLayout>

        <!-- Info -->
        <TextView
            style="@style/SettingsSectionTitle"
            android:text="Information" />

        <LinearLayout
            style="@style/SettingsCard">

            <include
                android:id="@+id/rowAbout"
                layout="@layout/item_settings_row_about" />

            <include
                android:id="@+id/rowPrivacy"
                layout="@layout/item_settings_row_privacy" />

            <include
                android:id="@+id/rowTerms"
                layout="@layout/item_settings_row_terms" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>