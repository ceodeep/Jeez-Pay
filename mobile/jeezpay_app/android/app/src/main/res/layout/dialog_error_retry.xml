<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="360dp"
    android:layout_height="241dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="18dp"
    android:background="@drawable/bg_dialog_error">

    <ImageView
        android:id="@+id/ivErrorIcon"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_error_red"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvErrorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Error occured"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#000000"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/tvErrorMessage"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:text="Something went wrong"
        android:textSize="14sp"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnErrorClose"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_dialog_btn_red"
            android:text="Close"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnErrorRetry"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="36dp"
            android:background="@drawable/bg_dialog_btn_green"
            android:text="Try again"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>